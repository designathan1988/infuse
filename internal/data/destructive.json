[
  {"id": "rm-recursive", "label": "rm -rf", "pattern": "(?:^|[\\s;&|(])rm\\s+(?:-[a-zA-Z-]+\\s+)*(?:-[a-zA-Z]*[rR][a-zA-Z]*[fF]|-[a-zA-Z]*[fF][a-zA-Z]*[rR]|-[rR]\\s+-[fF]|-[fF]\\s+-[rR]|--recursive\\s+--force|--force\\s+--recursive)"},
  {"id": "git-push-force", "label": "git push --force", "pattern": "git\\s+(?:-\\S+\\s+(?:[^-\\s]\\S*\\s+)?)*push\\b[^;&|\\n]*(?:\\s--force(?:-with-lease)?\\b|\\s-[a-zA-Z]*f\\b|\\s\\+\\S)"},
  {"id": "git-reset-hard", "label": "git reset --hard", "pattern": "git\\s+(?:-\\S+\\s+(?:[^-\\s]\\S*\\s+)?)*reset\\b[^;&|\\n]*\\s--hard\\b"},
  {"id": "git-clean", "label": "git clean", "pattern": "git\\s+(?:-\\S+\\s+(?:[^-\\s]\\S*\\s+)?)*clean\\b[^;&|\\n]*\\s-[a-zA-Z]*[fdxX]"},
  {"id": "sql-drop", "label": "drop table", "pattern": "(?i)\\bdrop\\s+(?:table|database|schema)\\b"},
  {"id": "sql-truncate", "label": "truncate table", "pattern": "(?i)\\btruncate\\s+table\\b"},
  {"id": "ps-remove-recurse", "label": "Remove-Item -Recurse -Force", "pattern": "(?i)remove-item\\b[^;&|\\n]*-recurse\\b[^;&|\\n]*-force\\b|(?i)remove-item\\b[^;&|\\n]*-force\\b[^;&|\\n]*-recurse\\b"},
  {"id": "cmd-rmdir", "label": "rd /s /q", "pattern": "(?i)\\b(?:rd|rmdir)\\s+/s\\s+/q\\b"}
]
