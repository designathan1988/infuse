package {{package}}

// Versioned persistence: every document carries its schema version, and an older one is migrated
// on load. Writes are atomic: a crash never leaves half a document.

import (
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"path/filepath"
)

// SchemaVersion is the current version of the stored documents. Raise it and add a migration when
// the shape changes.
const SchemaVersion = 1

// Migrations upgrade a document from the version in the key to the next one.
var Migrations = map[int]func(json.RawMessage) (json.RawMessage, error){}

type envelope struct {
	SchemaVersion int             `json:"schemaVersion"`
	Data          json.RawMessage `json:"data"`
}

// SaveDocument writes v at path, stamped with the current version.
func SaveDocument(path string, v any) error {
	body, err := json.Marshal(v)
	if err != nil {
		return err
	}
	out, err := json.MarshalIndent(envelope{SchemaVersion, body}, "", "  ")
	if err != nil {
		return err
	}
	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
		return err
	}
	tmp := path + ".tmp"
	if err := os.WriteFile(tmp, append(out, '\n'), 0o644); err != nil {
		return err
	}
	return os.Rename(tmp, path)
}

// LoadDocument reads path into v, migrating older versions. A missing file leaves v as it is.
func LoadDocument(path string, v any) error {
	b, err := os.ReadFile(path)
	if errors.Is(err, os.ErrNotExist) {
		return nil
	}
	if err != nil {
		return err
	}
	var e envelope
	if err := json.Unmarshal(b, &e); err != nil {
		return fmt.Errorf("%s: %w", path, err)
	}
	for e.SchemaVersion < SchemaVersion {
		up, ok := Migrations[e.SchemaVersion]
		if !ok {
			return fmt.Errorf("%s: no migration from version %d", path, e.SchemaVersion)
		}
		if e.Data, err = up(e.Data); err != nil {
			return err
		}
		e.SchemaVersion++
	}
	return json.Unmarshal(e.Data, v)
}
