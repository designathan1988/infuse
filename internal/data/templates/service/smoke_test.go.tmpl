package tests

// The observable surface: every job ends in a final state, and the queue survives a reopen.

import (
	"context"
	"errors"
	"path/filepath"
	"testing"

	"{{module}}/internal/platform"
	"{{module}}/internal/queue"
	"{{module}}/internal/workers"
)

func TestPoolDrainsTheQueue(t *testing.T) {
	platform.SetHook(func(platform.Event) {})
	workers.Handlers.Register("ok", func(context.Context, string) error { return nil })
	workers.Handlers.Register("bad", func(context.Context, string) error { return errors.New("boom") })
	file := filepath.Join(t.TempDir(), "jobs.json")
	q, err := queue.Open(file)
	if err != nil {
		t.Fatal(err)
	}
	for _, kind := range []string{"ok", "ok", "bad"} {
		if _, err := q.Add(kind, "x"); err != nil {
			t.Fatal(err)
		}
	}
	if err := workers.Drain(context.Background(), q, 2); err != nil {
		t.Fatal(err)
	}
	again, err := queue.Open(file)
	if err != nil {
		t.Fatal(err)
	}
	states := map[queue.State]int{}
	for _, j := range again.Jobs() {
		states[j.State]++
	}
	if states[queue.Done] != 2 || states[queue.Failed] != 1 {
		t.Fatalf("final states: %v", states)
	}
}
